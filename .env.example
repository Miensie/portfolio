# URL publique du site (sans barre finale). Sert au sitemap, au robots.txt
# et aux métadonnées de partage. Exemple : https://koffi-amani.vercel.app
NEXT_PUBLIC_SITE_URL=

# Clé d'accès Web3Forms (gratuite, https://web3forms.com) pour activer le
# formulaire de contact. Laisser vide : la page Contact affiche alors
# uniquement le lien e-mail, sans formulaire.
NEXT_PUBLIC_WEB3FORMS_KEY=
